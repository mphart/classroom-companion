# Optional variables for Docker Compose.
# Compose reads THIS file (repo root) for ${VAR} substitution into containers — not backend/.env.
# If you only set keys in backend/.env for `npm run dev`, duplicate them here for `docker compose up`.

# JWT_SECRET=use-a-long-random-string-in-production
# WEB_PORT=8080

# Google Gemini — summaries + single-note summarize (required for those features in the app)
# GEMINI_API_KEY=your-key-from-ai-google-dev
# Optional: GEMINI_MODEL=gemini-2.5-flash-lite

# Live recording slide sync (`POST /ai/slide-match`). Uses its own quota when set; otherwise falls back to GEMINI_API_KEY.
# SLIDESHOW_API_KEY=

# AssemblyAI — POST /youtube/parse (transcription after yt-dlp audio download). Requires ffmpeg + yt-dlp on PATH locally.
# ASSEMBLYAI_API_KEY=

# Practice exams (generate + short-answer grading). Can equal GEMINI_API_KEY or use a separate key.
# PRACTICE_API_KEY=

# Gladia — live translation when Recording language is not English (same PCM as Deepgram; see backend README)
# GLADIO_API_KEY=
