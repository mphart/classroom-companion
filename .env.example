# Optional variables for Docker Compose (`docker compose` loads `.env` from this directory).

# JWT_SECRET=use-a-long-random-string-in-production
# WEB_PORT=8080

# Google Gemini (required for Generate AI Summary in the app UI)
# GEMINI_API_KEY=your-key-from-ai-google-dev
# Optional: GEMINI_MODEL=gemini-flash-latest

# Gladia (live translation when Recording language is not English; see backend README)
# GLADIO_API_KEY=
